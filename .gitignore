# =========================================================
# JAVA
# =========================================================

*.class
*.jar
*.war
*.ear
*.nar

# Excepción necesaria para Maven Wrapper
!.mvn/wrapper/maven-wrapper.jar

# JVM
hs_err_pid*
replay_pid*
*.hprof
*.pid
*.pid.lock
.attach_pid*


# =========================================================
# MAVEN
# =========================================================

# Directorios generados
target/
**/target/

# Archivos generados por Maven
dependency-reduced-pom.xml
.flattened-pom.xml

# Maven release
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# Maven Wrapper
# Estos archivos SÍ deben versionarse:
# mvnw
# mvnw.cmd
# .mvn/wrapper/maven-wrapper.properties
# .mvn/wrapper/maven-wrapper.jar

!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/maven-wrapper.properties
!.mvn/wrapper/maven-wrapper.jar


# =========================================================
# SPRING BOOT - CONFIGURACIÓN SENSIBLE
# =========================================================

# Configuraciones particulares de los microservicios
# que pueden contener usuarios, contraseñas,
# tokens, claves o URLs privadas.

cliente-service/src/main/resources/application.properties
pedidos-service/src/main/resources/application.properties
productos-service/src/main/resources/application.properties


