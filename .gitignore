# =========================================================
# NOTAS
# =========================================================

# Archivos que normalmente SÍ deben subirse:
#
# Dockerfile
# docker-compose.yml
# compose.yml
# pom.xml
# mvnw
# mvnw.cmd
# .mvn/wrapper/*
# README.md
# .env.example
#
# No deben subirse:
#
# .env
# contraseñas
# tokens
# certificados privados
# application.properties con secretos
# target/
# logs
# archivos de IDE